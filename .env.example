# Database Configuration
# For local development (embedded H2):
DB_URL=jdbc:h2:mem:mubeenmart;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
# For persistent file mode:
# DB_URL=jdbc:h2:file:./data/mubeenmart;DB_CLOSE_DELAY=-1
# For production server mode:
# DB_URL=jdbc:h2:tcp://localhost:9092/./data/mubeenmart
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# Connection Pool (HikariCP)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_IDLE_TIMEOUT=300000
HIKARI_CONNECTION_TIMEOUT=20000

# Application Settings
SESSION_TIMEOUT_MINUTES=30
APP_NAME=MubeenMart

# AI Chatbot Configuration (Section 11 & 17)
# Provider options: gemini | mock
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_INPUT_LENGTH=500
