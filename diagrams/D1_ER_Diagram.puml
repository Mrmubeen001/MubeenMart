@startuml D1_ER_Diagram
!theme plain
skinparam roundcorner 8
skinparam linetype ortho
skinparam shadowing false

entity "users" as users {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * name : VARCHAR(100)
  * email : VARCHAR(100) <<UNIQUE>>
  * password_hash : VARCHAR(255)
  * role : ENUM('BUYER','SELLER','ADMIN')
  * created_at : TIMESTAMP
}

entity "products" as products {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * seller_id : BIGINT <<FK, INDEXED>>
  * name : VARCHAR(200)
    description : CLOB
  * price : DECIMAL(10,2)
  * stock_qty : INT
  * category : VARCHAR(50) <<INDEXED>>
    image_url : VARCHAR(500)
  * created_at : TIMESTAMP
}

entity "orders" as orders {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * buyer_id : BIGINT <<FK, INDEXED>>
  * status : ENUM('PENDING','CONFIRMED','SHIPPED','DELIVERED','CANCELLED') <<INDEXED>>
  * total_amount : DECIMAL(10,2)
  * created_at : TIMESTAMP <<INDEXED>>
}

entity "order_items" as order_items {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * order_id : BIGINT <<FK, INDEXED>>
  * product_id : BIGINT <<FK, INDEXED>>
  * quantity : INT
  * unit_price : DECIMAL(10,2)
  * created_at : TIMESTAMP
}

entity "cart_items" as cart_items {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * user_id : BIGINT <<FK, INDEXED>>
  * product_id : BIGINT <<FK, INDEXED>>
  * quantity : INT
  * created_at : TIMESTAMP
}

entity "reviews" as reviews {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * product_id : BIGINT <<FK, INDEXED>>
  * user_id : BIGINT <<FK, INDEXED>>
  * rating : INT (1-5)
    comment : CLOB
  * created_at : TIMESTAMP
}

entity "wishlist_items" as wishlist_items {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * user_id : BIGINT <<FK, INDEXED>>
  * product_id : BIGINT <<FK, INDEXED>>
  * created_at : TIMESTAMP
}

users ||--o{ products : "lists (1:N)"
users ||--o{ orders : "places (1:N)"
orders ||--|{ order_items : "contains (1:N)"
products ||--o{ order_items : "referenced in (1:N)"
users ||--o{ cart_items : "has (1:N)"
products ||--o{ cart_items : "added in (1:N)"
users ||--o{ reviews : "writes (1:N)"
products ||--o{ reviews : "receives (1:N)"
users ||--o{ wishlist_items : "saves (1:N)"
products ||--o{ wishlist_items : "saved as (1:N)"

@enduml
